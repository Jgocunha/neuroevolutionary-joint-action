{
  "name": "imgui-platform-kit",
  "version-date": "2026-02-18",
  "description": "Cross-platform toolkit for Dear ImGui",
  "homepage": "https://github.com/Jgocunha/imgui-platform-kit",
  "license": null,
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        { "name": "dx12-binding", "platform": "windows" },
        { "name": "win32-binding", "platform": "windows" },
        { "name": "glfw-binding", "platform": "!windows" },
        { "name": "opengl3-binding", "platform": "!windows" }
      ]
    },
    { "name": "glfw3", "platform": "!windows" },
    "implot",
    "imgui-node-editor",
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ]
}
